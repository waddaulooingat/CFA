  "beats": [
    {
      "id": "concept",
      "type": "Concept",
      "title": "Slope tests for parallel and perpendicular",
      "scene": "scene_cp_concept",
      "proseRef": "05-coordinate-parallel.md#concept"
    },
    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Match the slope",
      "scene": "scene_cp_manipulate",
      "instruction": "A fixed line ℓ has a known slope. Drag the handle on the second line until its slope EQUALS the slope of ℓ (parallel). Then toggle to PERPENDICULAR mode and drag until the slopes are negative reciprocals.",
      "successCondition": {
        "type": "slopeMatch",
        "modes": [
          { "mode": "parallel", "test": "m1 == m2", "tolerance": 0.05 },
          { "mode": "perpendicular", "test": "m1 * m2 == -1", "tolerance": 0.05 }
        ],
        "completeWhenAll": true
      },
      "successMessage": "Both relationships in hand. Slope is your new shortcut for parallel and perpendicular.",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Line through (3, −2) perpendicular to y = (1/2)x + 4",
      "scene": "scene_cp_worked",
      "steps": [
        {
          "order": 1,
          "text": "Given line slope m₁ = 1/2.",
          "canvasAction": { "type": "annotate", "target": "givenLine", "text": "m = 1/2" }
        },
        {
          "order": 2,
          "text": "Perpendicular slope is the negative reciprocal: m₂ = −2.",
          "canvasAction": null
        },
        {
          "order": 3,
          "text": "Use point-slope form with (3, −2) and slope −2: y + 2 = −2(x − 3).",
          "canvasAction": null
        },
        {
          "order": 4,
          "text": "Simplify: y = −2x + 4. Check: m₁ · m₂ = (1/2)(−2) = −1 ✓; (3, −2) satisfies y = −2x + 4 ✓.",
          "canvasAction": { "type": "annotate", "target": "newLine", "text": "y = −2x + 4" }
        }
      ]
    },
    {
      "id": "check",
      "type": "Check",
      "items": [
        {
          "id": "cp-check-1",
          "kind": "multipleChoice",
          "prompt": "Two lines are parallel iff their slopes are…",
          "choices": ["equal", "opposite", "negative reciprocals", "both zero"],
          "answerIndex": 0
        },
        {
          "id": "cp-check-2",
          "kind": "multipleChoice",
          "prompt": "Two lines are perpendicular iff their slopes…",
          "choices": ["are equal", "are opposites", "have product −1", "sum to 0"],
          "answerIndex": 2
        }
      ]
