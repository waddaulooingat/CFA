        {
          "id": "cp-prac-5",
          "kind": "freeResponse",
          "prompt": "Write the equation in slope-intercept form (y = mx + b) of the line through (0, 5) PARALLEL to y = 4x − 7.",
          "answer": "y = 4x + 5",
          "acceptableAnswers": ["y = 4x + 5", "y=4x+5", "y = 4x+5", "4x + 5"],
          "hints": [
            "Parallel → same slope.",
            "Same slope 4. y-intercept 5 from the point (0, 5).",
            "y = 4x + 5."
          ]
        }
      ]
