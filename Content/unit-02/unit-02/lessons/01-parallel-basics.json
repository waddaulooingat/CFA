{
  "skillId": "geo-u2-parallel-basics",
  "lessonVersion": 1,
  "beats": [
    {
      "id": "concept",
      "type": "Concept",
      "title": "Parallel, Perpendicular, Skew",
      "scene": "scene_pb_concept",
      "proseRef": "01-parallel-basics.md#concept"
    },
    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Make them parallel",
      "scene": "scene_pb_manipulate",
      "instruction": "Rotate line m around point P until m is parallel to line ℓ.",
      "successCondition": {
        "type": "linesParallel",
        "line1": "ell",
        "line2": "m",
        "tolerance": 1.0
      },
      "successMessage": "Parallel! Notice the matching arrows that appear on both lines.",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Two perpendiculars to the same line",
      "scene": "scene_pb_worked",
      "steps": [
        {
          "order": 1,
          "text": "Line a meets line b at 90°. Mark the right angle.",
          "canvasAction": { "type": "highlight", "target": "ab_intersection" }
        },
        {
          "order": 2,
          "text": "Line c also meets line b at 90°. Mark that right angle too.",
          "canvasAction": { "type": "highlight", "target": "cb_intersection" }
        },
        {
          "order": 3,
          "text": "In a plane, only one direction is perpendicular to b. Both a and c go in that direction, so they point the same way — they are parallel.",
          "canvasAction": { "type": "annotate", "target": "a_and_c", "text": "a ∥ c" }
        }
      ]
    },
    {
      "id": "check",
      "type": "Check",
      "items": [
        {
          "id": "pb-check-1",
          "kind": "multipleChoice",
          "prompt": "Two lines that lie in the same plane and never intersect are…",
          "choices": ["perpendicular", "parallel", "skew", "concurrent"],
          "answerIndex": 1,
          "explanation": "Same plane + never intersect = parallel."
        },
        {
          "id": "pb-check-2",
          "kind": "multipleChoice",
          "prompt": "Which symbol means 'is perpendicular to'?",
          "choices": ["∥", "⊥", "≅", "≠"],
          "answerIndex": 1
        }
      ]
    },
    {
      "id": "practice",
      "type": "Practice",
      "items": [
        {
          "id": "pb-prac-1",
          "kind": "multipleChoice",
          "prompt": "Two lines that do NOT lie in the same plane and never intersect are…",
          "choices": ["parallel", "perpendicular", "skew", "intersecting"],
          "answerIndex": 2,
          "hints": [
            "Parallel requires the same plane. What if the lines aren't coplanar?",
            "Skew lines are non-coplanar and non-intersecting.",
            "Skew."
          ]
        },
        {
          "id": "pb-prac-2",
          "kind": "multipleChoice",
          "prompt": "Through a point not on a given line, how many lines parallel to the given line exist?",
          "choices": ["0", "exactly 1", "exactly 2", "infinitely many"],
          "answerIndex": 1,
          "hints": [
            "This is the Parallel Postulate.",
            "Exactly one.",
            "Through a point not on a line, exactly one line is parallel to it."
          ]
        },
        {
          "id": "pb-prac-3",
          "kind": "multipleChoice",
          "prompt": "Lines a and b are perpendicular. Lines a and c are also perpendicular. What is the relationship between b and c (in the same plane)?",
          "choices": ["parallel", "perpendicular", "skew", "cannot be determined"],
          "answerIndex": 0,
          "hints": [
            "Both b and c are perpendicular to the same line.",
            "Two lines perpendicular to the same line in a plane must be parallel.",
            "b ∥ c."
          ]
        },
        {
          "id": "pb-prac-4",
          "kind": "multipleChoice",
          "prompt": "Which is a real-world example of skew lines?",
          "choices": [
            "Railroad tracks",
            "The cross at the top of a flagpole",
            "An edge of the ceiling and an edge of the floor at different walls",
            "Two pages of an open book"
          ],
          "answerIndex": 2,
          "hints": [
            "Skew = not coplanar, not intersecting.",
            "Look for two lines that exist in 3D space but never share a plane.",
            "Different-wall edges of ceiling and floor are skew."
          ]
        }
      ]
    },
    {
      "id": "reflection",
      "type": "Reflection",
      "proseRef": "01-parallel-basics.md#reflection"
    }
  ],
