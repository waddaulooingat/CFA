    {
      "id": "pb-test-3",
      "kind": "multipleChoice",
      "category": "conceptual",
      "prompt": "Which statement about parallel lines is FALSE?",
      "choices": [
        "They lie in the same plane.",
        "They never intersect.",
        "They have exactly one point in common.",
        "Through an outside point, exactly one line is parallel to them."
      ],
      "answerIndex": 2,
      "difficulty": 2
    },
    {
      "id": "pb-test-4",
      "kind": "multipleChoice",
      "category": "conceptual",
      "prompt": "Two lines that never intersect must be parallel. TRUE or FALSE?",
      "choices": ["True", "False"],
      "answerIndex": 1,
      "explanation": "Skew lines never intersect either — but they aren't coplanar so they aren't parallel.",
      "difficulty": 2
    },
    {
      "id": "pb-test-5",
      "kind": "multipleChoice",
      "category": "transfer",
      "prompt": "Lines p and q are both perpendicular to line r in the same plane. Lines q and s are perpendicular. What is the relationship between p and s?",
      "choices": ["parallel", "perpendicular", "skew", "cannot be determined"],
      "answerIndex": 1,
      "explanation": "p ∥ q (both perpendicular to r). q ⊥ s. So p ⊥ s.",
      "difficulty": 3
    },
    {
      "id": "pb-test-6",
      "kind": "multipleChoice",
      "category": "transfer",
      "prompt": "In a rectangular room, an edge of the ceiling and an edge of the floor that are NOT directly above each other are…",
      "choices": ["parallel", "perpendicular", "skew", "intersecting"],
      "answerIndex": 2,
      "explanation": "Different elevations + different walls = different planes. Non-coplanar, non-intersecting = skew.",
      "difficulty": 3
    }
