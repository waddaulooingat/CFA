    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Drag and observe",
      "scene": "scene_pt_manipulate",
      "instruction": "Two parallel lines are cut by a transversal. Drag the transversal handle to change the crossing angle. Watch: corresponding pairs stay equal, alt interior pairs stay equal, co-interior pairs always sum to 180°. Move through at least three different positions.",
      "successCondition": {
        "type": "explorationGoal",
        "milestones": [
          { "id": "transv-angle-30", "test": "transversalAngleRange:25-40" },
          { "id": "transv-angle-60", "test": "transversalAngleRange:55-70" },
          { "id": "transv-angle-near-perp", "test": "transversalAngleRange:80-100" }
        ],
        "completeWhenAll": true
      },
      "successMessage": "Confirmed — the theorems hold no matter the transversal angle.",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Find all eight angles",
      "scene": "scene_pt_worked",
      "steps": [
        {
          "order": 1,
          "text": "∠1 = 65° given. ∠2 is a linear pair with ∠1, so ∠2 = 115°.",
          "canvasAction": { "type": "annotate", "target": "angle2", "text": "115°" }
        },
        {
          "order": 2,
          "text": "∠3 is vertical to ∠1, so ∠3 = 65°. ∠4 is vertical to ∠2, so ∠4 = 115°.",
          "canvasAction": { "type": "annotate", "target": ["angle3", "angle4"], "text": "65°, 115°" }
        },
        {
          "order": 3,
          "text": "By Corresponding Angles Postulate: ∠5 = ∠1 = 65°. By same: ∠6 = 115°, ∠7 = 65°, ∠8 = 115°.",
          "canvasAction": { "type": "annotate", "target": ["angle5", "angle6", "angle7", "angle8"], "text": "all set" }
        },
        {
          "order": 4,
          "text": "Sanity check: alt interior ∠3 = ∠5 (both 65° ✓). Co-interior ∠4 + ∠5 = 115 + 65 = 180° ✓",
          "canvasAction": null
        }
      ]
    },
