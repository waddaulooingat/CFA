  "beats": [
    {
      "id": "concept",
      "type": "Concept",
      "title": "The Eight Angles a Transversal Makes",
      "scene": "scene_ta_concept",
      "proseRef": "02-transversal-angles.md#concept"
    },
    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Click the pair",
      "scene": "scene_ta_manipulate",
      "instruction": "A pair-type prompt will appear above the canvas (e.g., 'Click an alternate interior pair'). Click the two angles that satisfy it. The drill cycles through corresponding, alternate interior, alternate exterior, co-interior, and vertical angle pairs.",
      "successCondition": {
        "type": "drillComplete",
        "rounds": 6,
        "promptCycle": [
          { "promptText": "Click a CORRESPONDING pair.", "validPairs": [["1","5"],["2","6"],["3","7"],["4","8"]] },
          { "promptText": "Click an ALTERNATE INTERIOR pair.", "validPairs": [["3","5"],["4","6"]] },
          { "promptText": "Click an ALTERNATE EXTERIOR pair.", "validPairs": [["1","7"],["2","8"]] },
          { "promptText": "Click a CO-INTERIOR (same-side interior) pair.", "validPairs": [["4","5"],["3","6"]] },
          { "promptText": "Click a VERTICAL pair.", "validPairs": [["1","3"],["2","4"],["5","7"],["6","8"]] },
          { "promptText": "Click a LINEAR PAIR.", "validPairs": [["1","2"],["2","3"],["3","4"],["4","1"],["5","6"],["6","7"],["7","8"],["8","5"]] }
        ]
      },
      "successMessage": "Naming locked in. Move on to theorems.",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Naming five pairs",
      "scene": "scene_ta_worked",
      "steps": [
        {
          "order": 1,
          "text": "∠2 and ∠6: both in the upper-right position at their intersections. Same position = corresponding.",
          "canvasAction": { "type": "highlight", "target": ["angle2", "angle6"] }
        },
        {
          "order": 2,
          "text": "∠3 and ∠5: both interior, opposite sides of the transversal. Alternate interior.",
          "canvasAction": { "type": "highlight", "target": ["angle3", "angle5"] }
        },
        {
          "order": 3,
          "text": "∠4 and ∠5: both interior, same side of the transversal. Co-interior.",
          "canvasAction": { "type": "highlight", "target": ["angle4", "angle5"] }
        },
        {
          "order": 4,
          "text": "∠1 and ∠3: both at the top intersection, opposite. Vertical angles.",
          "canvasAction": { "type": "highlight", "target": ["angle1", "angle3"] }
        },
        {
          "order": 5,
          "text": "∠1 and ∠7: both exterior, opposite sides of the transversal. Alternate exterior.",
          "canvasAction": { "type": "highlight", "target": ["angle1", "angle7"] }
        }
      ]
    },
