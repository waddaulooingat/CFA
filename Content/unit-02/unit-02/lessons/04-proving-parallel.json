  "beats": [
    {
      "id": "concept",
      "type": "Concept",
      "title": "Proving Lines Parallel (the converses)",
      "scene": "scene_pp_concept",
      "proseRef": "04-proving-parallel.md#concept"
    },
    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Make them parallel",
      "scene": "scene_pp_manipulate",
      "instruction": "Two lines are cut by a transversal. Drag the bottom line until the corresponding angle pair is congruent — at that moment, the lines become parallel.",
      "successCondition": {
        "type": "anglePairCongruent",
        "pair": "corresponding",
        "tolerance": 1.0
      },
      "successMessage": "Corresponding angles equal → lines parallel. (Converse of the Corresponding Angles Postulate.)",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Use the converse to conclude parallel",
      "scene": "scene_pp_worked",
      "steps": [
        {
          "order": 1,
          "text": "Given: ∠3 = 72° and ∠5 = 72°. ∠3 and ∠5 are alternate interior angles.",
          "canvasAction": { "type": "highlight", "target": ["angle3", "angle5"] }
        },
        {
          "order": 2,
          "text": "Recall the Converse of the Alternate Interior Angles Theorem: if alternate interior angles are congruent, then the lines are parallel.",
          "canvasAction": null
        },
        {
          "order": 3,
          "text": "∠3 ≅ ∠5 (given), so a ∥ b. Mark them parallel.",
          "canvasAction": { "type": "annotate", "target": "lines", "text": "a ∥ b" }
        }
      ]
    },
    {
      "id": "check",
      "type": "Check",
      "items": [
        {
          "id": "pp-check-1",
          "kind": "multipleChoice",
          "prompt": "Two lines cut by a transversal have congruent corresponding angles. What can you conclude?",
          "choices": [
            "Nothing — congruence is a coincidence.",
            "The lines are perpendicular.",
            "The lines are parallel.",
            "The lines are skew."
          ],
          "answerIndex": 2
        },
        {
          "id": "pp-check-2",
          "kind": "multipleChoice",
          "prompt": "Two lines cut by a transversal have supplementary co-interior angles. The lines are…",
          "choices": ["parallel", "perpendicular", "skew", "definitely not parallel"],
          "answerIndex": 0
        }
      ]
    },
    {
      "id": "practice",
      "type": "Practice",
      "items": [
        {
          "id": "pp-prac-1",
          "kind": "multipleChoice",
          "prompt": "∠1 and ∠5 are corresponding. ∠1 = 80°, ∠5 = 80°. Are the lines parallel?",
          "choices": ["Yes", "No", "Cannot tell"],
          "answerIndex": 0,
          "hints": [
            "Corresponding angles congruent → lines parallel.",
            "Converse of the Corresponding Angles Postulate."
          ]
        },
        {
          "id": "pp-prac-2",
          "kind": "multipleChoice",
          "prompt": "∠3 and ∠6 are co-interior. ∠3 = 100°, ∠6 = 75°. Are the lines parallel?",
          "choices": ["Yes", "No", "Cannot tell"],
          "answerIndex": 1,
          "hints": [
            "For parallel via co-interior, the pair must be SUPPLEMENTARY (sum to 180°).",
            "100 + 75 = 175 ≠ 180.",
            "Not parallel."
          ]
        },
        {
          "id": "pp-prac-3",
          "kind": "multipleChoice",
          "prompt": "∠2 and ∠8 are alternate exterior. ∠2 = 65°, ∠8 = 65°. Are the lines parallel?",
          "choices": ["Yes", "No", "Cannot tell"],
          "answerIndex": 0,
          "hints": [
            "Alternate exterior congruent → lines parallel.",
            "Converse of the Alternate Exterior Angles Theorem."
          ]
        },
        {
          "id": "pp-prac-4",
          "kind": "numeric",
          "prompt": "Lines a and b are cut by transversal t. ∠1 and ∠5 are corresponding. ∠1 = (4x + 10)°, ∠5 = (2x + 50)°. For what value of x are a and b parallel?",
          "answer": 20,
          "tolerance": 0.01,
          "hints": [
            "Set the corresponding angles equal.",
            "4x + 10 = 2x + 50.",
            "2x = 40 ⇒ x = 20."
          ]
        },
        {
          "id": "pp-prac-5",
          "kind": "multipleChoice",
          "prompt": "Two distinct lines are both parallel to a third line. The two lines are…",
          "choices": ["parallel to each other", "perpendicular to each other", "skew", "the same line"],
          "answerIndex": 0,
          "hints": [
            "Transitivity of parallel.",
            "If a ∥ c and b ∥ c, then a ∥ b."
          ]
        }
      ]
    },
