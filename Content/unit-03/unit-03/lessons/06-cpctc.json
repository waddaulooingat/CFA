    {
      "id": "cpctc-test-2",
      "kind": "multipleChoice",
      "category": "procedural",
      "prompt": "In a proof, △MNP ≅ △XYZ (with M↔X, N↔Y, P↔Z) is established by SAS. Which reason justifies 'NP ≅ YZ'?",
      "choices": ["SAS", "CPCTC", "Reflexive Property", "Given"],
      "answerIndex": 1,
      "difficulty": 1
    },
    {
      "id": "cpctc-test-3",
      "kind": "multipleChoice",
      "category": "conceptual",
      "prompt": "A student writes 'AB ≅ DE by CPCTC' as the first line of a proof. What error did the student make?",
      "choices": [
        "CPCTC can only apply to angles, not sides",
        "CPCTC requires the triangles to be congruent first — it cannot appear before that step",
        "AB and DE are not corresponding parts",
        "The student wrote the sides in the wrong order"
      ],
      "answerIndex": 1,
      "difficulty": 2
    },
    {
      "id": "cpctc-test-4",
      "kind": "multipleChoice",
      "category": "conceptual",
      "prompt": "△ABC ≅ △CDA (proved by SSS, with A↔C, B↔D, C↔A). Which conclusion follows by CPCTC?",
      "choices": [
        "∠ABC ≅ ∠CDA",
        "AB ≅ CA",
        "Both A and B",
        "Neither — CPCTC only applies when triangles are labeled differently"
      ],
      "answerIndex": 2,
      "difficulty": 2
    },
    {
      "id": "cpctc-test-5",
      "kind": "multipleChoice",
      "category": "transfer",
      "prompt": "To prove that the base angles of an isosceles triangle are congruent, a student draws the altitude from the apex. She proves the two right triangles congruent by HL. What is her final reason?",
      "choices": ["HL", "CPCTC", "Isosceles Triangle Theorem", "SAS"],
      "answerIndex": 1,
      "difficulty": 2
    },
