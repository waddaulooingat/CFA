      "id": "cpctc-test-6",
      "kind": "multipleChoice",
      "category": "transfer",
      "prompt": "In rhombus ABCD, diagonal AC is drawn. △ABC ≅ △CDA by SSS. By CPCTC, ∠BAC ≅ ∠DCA. What geometric conclusion can be drawn from this?",
      "choices": [
        "AC is a perpendicular bisector of BD",
        "AC bisects angles ∠BAD and ∠BCD",
        "AB is parallel to CD",
        "The rhombus is a square"
      ],
      "answerIndex": 1,
      "difficulty": 3
    },
