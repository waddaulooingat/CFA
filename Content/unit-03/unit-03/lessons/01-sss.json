    {
      "id": "concept",
      "type": "Concept",
      "title": "SSS Congruence Postulate",
      "scene": "scene_sss_concept",
      "proseRef": "01-sss.md#concept"
    },
    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Match the third side",
      "scene": "scene_sss_manipulate",
      "instruction": "Drag point F until segment EF has the same length as segment BC (shown in blue). When all three pairs of sides are equal, the triangles are congruent by SSS.",
      "successCondition": {
        "type": "equalLengths",
        "of": "EF",
        "and": "BC",
        "tolerance": 0.15
      },
      "successMessage": "All three pairs of sides are congruent! By SSS, △ABC ≅ △DEF.",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Proving △ABC ≅ △DEF by SSS",
      "scene": "scene_sss_worked",
      "steps": [
        {
          "order": 1,
          "text": "Identify three pairs of sides. AB = DE = 5, so AB ≅ DE (first pair of congruent sides).",
          "canvasAction": { "type": "highlight", "target": "AB" }
        },
        {
          "order": 2,
          "text": "BC = EF = 4, so BC ≅ EF (second pair of congruent sides).",
          "canvasAction": { "type": "highlight", "target": "BC" }
        },
        {
          "order": 3,
          "text": "CA = FD = 3, so CA ≅ FD (third pair). All three pairs match — by SSS, △ABC ≅ △DEF.",
          "canvasAction": { "type": "annotate", "target": "both_triangles", "text": "△ABC ≅ △DEF (SSS)" }
        }
      ]
    },
    {
      "id": "check",
      "type": "Check",
      "items": [
        {
          "id": "sss-check-1",
          "kind": "multipleChoice",
          "prompt": "SSS stands for which combination of congruent parts?",
          "choices": [
            "Side-Side-Side",
            "Side-Angle-Side",
            "Angle-Side-Angle",
            "Side-Angle-Angle"
          ],
          "answerIndex": 0,
          "explanation": "SSS = Side-Side-Side: all three pairs of corresponding sides must be congruent."
        },
        {
          "id": "sss-check-2",
          "kind": "multipleChoice",
          "prompt": "△PQR has PQ = 6, QR = 8, RP = 10. △XYZ has XY = 6, YZ = 8, ZX = 10. Which postulate proves △PQR ≅ △XYZ?",
          "choices": ["SSS", "SAS", "ASA", "Cannot be determined"],
          "answerIndex": 0,
          "explanation": "All three pairs of corresponding sides are equal, so SSS applies."
        }
      ]
    },
    {
      "id": "practice",
      "type": "Practice",
      "items": [
        {
          "id": "sss-prac-1",
          "kind": "multipleChoice",
          "prompt": "To use SSS, how many pairs of congruent sides must you establish?",
          "choices": ["1", "2", "3", "4"],
          "answerIndex": 2,
          "hints": [
            "SSS uses three letters — one for each condition.",
            "Each S stands for one pair of congruent sides.",
            "You need all three pairs: AB≅DE, BC≅EF, and CA≅FD."
          ]
        },
        {
          "id": "sss-prac-2",
          "kind": "multipleChoice",
          "prompt": "△ABC has AB = 7, BC = 9, CA = 5. Which set of side lengths in △DEF would allow SSS congruence with △ABC?",
          "choices": [
            "DE = 7, EF = 9, FD = 5",
            "DE = 7, EF = 5, FD = 9",
            "DE = 9, EF = 7, FD = 5",
            "All of the above"
          ],
          "answerIndex": 0,
          "hints": [
            "Corresponding vertices must match: A↔D, B↔E, C↔F.",
            "AB corresponds to DE, BC to EF, CA to FD.",
            "DE = 7 = AB, EF = 9 = BC, FD = 5 = CA."
          ]
        },
        {
          "id": "sss-prac-3",
          "kind": "multipleChoice",
          "prompt": "Two triangles share a common side. You also know two other pairs of sides are congruent. Which postulate applies?",
          "choices": ["SSS", "SAS", "HL", "AAS"],
          "answerIndex": 0,
          "hints": [
            "A shared side is congruent to itself (Reflexive Property).",
            "Shared side + two other pairs gives three total pairs of congruent sides.",
            "Three pairs of congruent sides → SSS."
          ]
        },
        {
          "id": "sss-prac-4",
          "kind": "multipleChoice",
          "prompt": "Can SSS be used if you only know that two pairs of sides are congruent and one pair of angles is congruent?",
          "choices": [
            "Yes, because two sides and an angle are enough",
            "No, SSS requires all three pairs of sides",
            "Yes, if the angle is between the two sides",
            "No, you need all three angles"
          ],
          "answerIndex": 1,
          "hints": [
            "What does the third S in SSS require?",
            "SSS needs Side-Side-Side — three pairs of sides, no angles.",
            "No — SSS strictly requires three pairs of congruent sides."
          ]
        }
      ]
    },
