  "beats": [
    {
      "id": "concept",
      "type": "Concept",
      "title": "Angle Measure and Types",
      "scene": "scene_ang_concept",
      "proseRef": "03-angle-measure.md#concept"
    },
    {
      "id": "manipulate",
      "type": "Manipulate",
      "title": "Build a right angle",
      "scene": "scene_ang_manipulate",
      "instruction": "Drag point C until angle ABC measures 90°.",
      "successCondition": {
        "type": "angleMeasure",
        "vertex": "B",
        "sides": ["A", "C"],
        "targetDegrees": 90,
        "tolerance": 1.0
      },
      "successMessage": "Right angle achieved.",
      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Angle Addition",
      "scene": "scene_ang_worked",
      "steps": [
        {
          "order": 1,
          "text": "Ray BD is in the interior of angle ABC, so the Angle Addition Postulate applies.",
          "canvasAction": { "type": "highlight", "target": "rayBD" }
        },
        {
          "order": 2,
          "text": "Write: m∠ABD + m∠DBC = m∠ABC.",
          "canvasAction": null
        },
        {
          "order": 3,
          "text": "Substitute: 35° + 47° = m∠ABC.",
          "canvasAction": { "type": "annotate", "target": "angleABD", "text": "35°" }
        },
        {
          "order": 4,
          "text": "Add: m∠ABC = 82°. Since 82° is between 0° and 90°, it's acute.",
          "canvasAction": { "type": "annotate", "target": "angleABC", "text": "82° (acute)" }
        }
      ]
    },
    {
      "id": "check",
      "type": "Check",
      "items": [
        {
          "id": "ang-check-1",
          "kind": "multipleChoice",
          "prompt": "In angle XYZ, which point is the vertex?",
          "choices": ["X", "Y", "Z", "Cannot tell"],
          "answerIndex": 1,
          "explanation": "The middle letter is always the vertex."
        },
        {
          "id": "ang-check-2",
          "kind": "multipleChoice",
          "prompt": "An angle measuring 145° is classified as…",
          "choices": ["acute", "right", "obtuse", "straight"],
          "answerIndex": 2,
          "explanation": "145° is between 90° and 180°, so it's obtuse."
        }
      ]
    },
    {
      "id": "practice",
      "type": "Practice",
      "items": [
        {
          "id": "ang-prac-1",
          "kind": "multipleChoice",
          "prompt": "Classify an angle measuring 90°.",
          "choices": ["acute", "right", "obtuse", "straight"],
          "answerIndex": 1,
          "hints": [
            "Recall the four classifications.",
            "Exactly 90° has a special name.",
            "An angle of exactly 90° is a right angle."
          ]
        },
        {
          "id": "ang-prac-2",
          "kind": "numeric",
          "prompt": "Ray BD is in the interior of angle ABC. m∠ABD = 28° and m∠DBC = 41°. Find m∠ABC.",
          "answer": 69,
          "tolerance": 0.01,
          "hints": [
            "Which postulate applies when a ray splits an angle?",
            "Angle Addition: m∠ABD + m∠DBC = m∠ABC.",
            "28 + 41 = 69°."
          ]
        },
        {
          "id": "ang-prac-3",
          "kind": "numeric",
          "prompt": "Ray BD bisects angle ABC. If m∠ABC = 64°, find m∠ABD.",
          "answer": 32,
          "tolerance": 0.01,
          "hints": [
            "A bisector cuts an angle into two equal pieces.",
            "Each half is m∠ABC / 2.",
            "64 / 2 = 32°."
          ]
        },
        {
          "id": "ang-prac-4",
          "kind": "multipleChoice",
          "prompt": "Which statement is TRUE?",
          "choices": [
            "Angle ABC equals angle ACB.",
            "Angle ABC equals angle CBA.",
            "Angle ABC equals angle BAC.",
            "Angle ABC equals angle BCA."
          ],
          "answerIndex": 1,
          "hints": [
            "Reading an angle name from either direction gives the same angle, as long as the vertex stays in the middle.",
            "The vertex is the middle letter.",
            "ABC and CBA both have vertex B with sides toward A and C — same angle."
          ]
        },
        {
          "id": "ang-prac-5",
          "kind": "numeric",
          "prompt": "Two angles form a straight line and one measures 53°. Find the other.",
          "answer": 127,
          "tolerance": 0.01,
          "hints": [
            "Two angles forming a straight line are supplementary.",
            "Supplementary angles sum to 180°.",
            "180 − 53 = 127°."
          ]
        }
      ]
    },
    {
      "id": "reflection",
      "type": "Reflection",
      "proseRef": "03-angle-measure.md#reflection"
    }
