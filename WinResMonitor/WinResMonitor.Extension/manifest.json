{
  "manifest_version": 3,
  "name": "WinResMonitor",
  "version": "1.0",
  "description": "Time tracking and site blocking for Chrome and Edge.",
  "permissions": ["tabs", "storage", "alarms", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WinResMonitor"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
