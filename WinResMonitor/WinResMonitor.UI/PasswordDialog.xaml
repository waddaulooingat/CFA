<Window x:Class="WinResMonitor.UI.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinResMonitor" Height="280" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Background="#f4f6f9">
        <StackPanel VerticalAlignment="Center" Margin="40">

            <!-- Header -->
            <Border Background="#2C3E50" CornerRadius="6" Padding="16,12" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="&#128274; WinResMonitor" Foreground="White"
                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SubtitleText" Text="Enter your password to continue"
                               Foreground="#aab" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Password field -->
            <TextBlock x:Name="FieldLabel" Text="Password:" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="8,6"
                         KeyDown="PasswordBox_KeyDown"/>

            <!-- Confirm field (shown only when setting password) -->
            <TextBlock x:Name="ConfirmLabel" Text="Confirm Password:" FontSize="13"
                       Margin="0,12,0,4" Visibility="Collapsed"/>
            <PasswordBox x:Name="ConfirmBox" FontSize="14" Padding="8,6"
                         Visibility="Collapsed" KeyDown="ConfirmBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Foreground="#c0392b" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Button x:Name="OkButton" Content="Unlock" Margin="0,20,0,0"
                    Padding="0,10" FontSize="14" Background="#2C3E50" Foreground="White"
                    BorderThickness="0" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
