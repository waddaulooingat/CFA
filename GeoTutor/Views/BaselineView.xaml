<UserControl x:Class="GeoTutor.Views.BaselineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <Grid>

        <!-- ══════════════════════════════════════════════════════════
             WELCOME SCREEN  (visible until StartBaseline is called)
             ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsStarted,
                             Converter={StaticResource BoolToCollapsedConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520">

                <TextBlock Text="Algebra Prerequisite Check"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="15"
                           Foreground="#A6ADC8"
                           LineHeight="24"
                           Margin="0,0,0,32">
                    Before starting Geometry, let's quickly check your
                    algebra skills. This short assessment covers
                    8 key areas — it takes about 5–10 minutes and
                    helps us personalise your learning path.
                </TextBlock>

                <!-- Topics covered -->
                <Border Background="#313244"
                        CornerRadius="8"
                        BorderBrush="#45475A"
                        BorderThickness="1"
                        Padding="20,16"
                        Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="TOPICS COVERED"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6C7086"
                                   LetterSpacing="1"
                                   Margin="0,0,0,10"/>
                        <UniformGrid Columns="2" Rows="4">
                            <TextBlock Text="✦  Linear equations"   Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Systems of equations" Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Factoring"          Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Quadratic formula"  Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Exponents &amp; radicals" Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Function notation"  Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Slope &amp; lines"  Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                            <TextBlock Text="✦  Distance &amp; midpoint" Foreground="#CDD6F4" FontSize="13" Margin="0,3"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Button Content="Start Assessment →"
                        Command="{Binding StartBaselineCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="15"
                        Padding="28,12"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             ASSESSMENT SCREEN  (IsStarted=true, IsComplete=false)
             ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsAssessing,
                             Converter={StaticResource BoolToVisibleConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress bar strip -->
            <Border Grid.Row="0"
                    Background="#181825"
                    BorderBrush="#45475A"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Algebra Prerequisite Assessment"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CDD6F4"
                                   Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding ItemsCompleted}"
                                     Maximum="{Binding TotalEstimatedItems}"
                                     Style="{StaticResource AccentProgressBar}"
                                     Height="6"
                                     Margin="0,0,24,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#6C7086">
                        <Run Text="{Binding ItemsCompleted}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalEstimatedItems}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Question area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid VerticalAlignment="Center" Margin="48,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="620"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <!-- Skill label -->
                        <Border Background="#1a3d35"
                                CornerRadius="12"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16"
                                Visibility="{Binding CurrentItem,
                                              Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding CurrentItem.SkillId}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#94E2D5"/>
                        </Border>

                        <!-- Question card -->
                        <Border Background="#313244"
                                CornerRadius="10"
                                BorderBrush="#45475A"
                                BorderThickness="1"
                                Padding="24,20"
                                Margin="0,0,0,20"
                                Visibility="{Binding CurrentItem,
                                              Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding CurrentItem.Prompt}"
                                       FontSize="17"
                                       Foreground="#CDD6F4"
                                       TextWrapping="Wrap"
                                       LineHeight="28"/>
                        </Border>

                        <!-- Multiple-choice options -->
                        <ListBox ItemsSource="{Binding Choices}"
                                 SelectedIndex="{Binding SelectedChoiceIndex, Mode=TwoWay}"
                                 Visibility="{Binding IsMultipleChoice,
                                               Converter={StaticResource BoolToVisibleConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,0,0,16">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root"
                                                        Background="#2a2c3e"
                                                        CornerRadius="8"
                                                        BorderThickness="2"
                                                        BorderBrush="#45475A"
                                                        Padding="16,12"
                                                        Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Letter badge -->
                                                        <Border x:Name="Badge"
                                                                Background="#45475A"
                                                                CornerRadius="4"
                                                                Width="22" Height="22">
                                                            <!-- tag showing A/B/C/D is done via converter-free approach: just blank for now -->
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{TemplateBinding Content}"
                                                                   Foreground="#CDD6F4"
                                                                   FontSize="14"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#89B4FA"/>
                                                        <Setter TargetName="Root" Property="Background" Value="#1a2e50"/>
                                                        <Setter TargetName="Badge" Property="Background" Value="#89B4FA"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected"  Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Root" Property="Background" Value="#35374d"/>
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#6C7086"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Numeric answer input -->
                        <TextBox Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 FontSize="15"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding IsMultipleChoice,
                                               Converter={StaticResource BoolToCollapsedConverter}}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding SubmitAnswerCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Feedback row -->
                        <TextBlock Text="{Binding FeedbackMessage}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A6ADC8"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FeedbackMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FeedbackMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <Trigger Property="Text" Value="Correct!">
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding FeedbackMessage}" Value="Correct!">
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FeedbackMessage}" Value="Not quite — moving on.">
                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FeedbackMessage}" Value="Please enter an answer before submitting.">
                                            <Setter Property="Foreground" Value="#FAB387"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Submit button -->
                        <Button Content="Submit Answer"
                                Command="{Binding SubmitAnswerCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="14"
                                Padding="20,10"
                                HorizontalAlignment="Left"/>

                        <!-- Loading indicator -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="#6C7086"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsBusy,
                                                 Converter={StaticResource BoolToVisibleConverter}}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             RESULTS SCREEN  (IsComplete=true)
             ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsComplete,
                             Converter={StaticResource BoolToVisibleConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
                <StackPanel HorizontalAlignment="Center"
                            Width="580"
                            Margin="0,40,0,40">

                    <!-- Header -->
                    <TextBlock Text="Assessment Complete!"
                               FontSize="30" FontWeight="Bold"
                               Foreground="#A6E3A1"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Readiness badge -->
                    <Border HorizontalAlignment="Center"
                            CornerRadius="20"
                            Padding="16,6"
                            Margin="0,0,0,28">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1a3d35"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.OverallReadiness}"
                                                 Value="Conditional">
                                        <Setter Property="Background" Value="#3a2e10"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result.OverallReadiness}"
                                                 Value="NotReady">
                                        <Setter Property="Background" Value="#3a1a1a"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A6E3A1"/>
                                    <Setter Property="Text"       Value="Ready for Geometry"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result.OverallReadiness}"
                                                     Value="Conditional">
                                            <Setter Property="Foreground" Value="#F9E2AF"/>
                                            <Setter Property="Text"       Value="Conditional — some gaps to fill"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result.OverallReadiness}"
                                                     Value="NotReady">
                                            <Setter Property="Foreground" Value="#F38BA8"/>
                                            <Setter Property="Text"       Value="Needs review before Geometry"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Skill breakdown card -->
                    <Border Background="#313244"
                            CornerRadius="10"
                            BorderBrush="#45475A"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="SKILL BREAKDOWN"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#6C7086"
                                       LetterSpacing="1"
                                       Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding ResultSummary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SkillName}"
                                                       FontSize="13"
                                                       Foreground="#CDD6F4"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="LvlBg" Color="#45475A"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Level}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#1E1E2E"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1E1E2E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Unknown">
                                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#45475A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Mastered">
                                                                <Setter Property="Background" Value="#A6E3A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Solid">
                                                                <Setter Property="Background" Value="#74C7EC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Developing">
                                                                <Setter Property="Background" Value="#F9E2AF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Shaky">
                                                                <Setter Property="Background" Value="#FAB387"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Retake button -->
                    <Button Content="Retake Assessment"
                            Command="{Binding StartBaselineCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="20,10"
                            FontSize="13"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
