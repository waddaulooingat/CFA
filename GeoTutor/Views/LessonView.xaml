<UserControl x:Class="GeoTutor.Views.LessonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scene="clr-namespace:GeoTutor.SceneEngine"
             xmlns:models="clr-namespace:GeoTutor.Core.Models"
             Background="#1E1E2E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="300"/>
            <ColumnDefinition Width="3*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL — beat content + answer + dialogue
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#181825"
                BorderBrush="#45475A"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- top bar -->
                    <RowDefinition Height="*"/>      <!-- scrollable body -->
                    <RowDefinition Height="Auto"/>  <!-- action row -->
                </Grid.RowDefinitions>

                <!-- Top bar: skill + beat progress -->
                <Border Grid.Row="0"
                        BorderBrush="#45475A" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding CurrentLesson.SkillId}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6C7086"/>

                        <!-- Beat progress dots -->
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding CurrentLesson.Beats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="8" Height="8" Margin="0,0,4,0"
                                             Fill="#45475A"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Scrollable body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>

                        <!-- Beat type chip -->
                        <Border Background="#313244" CornerRadius="4"
                                Padding="8,3" HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding CurrentBeat.Type}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#89B4FA"/>
                        </Border>

                        <!-- Prose / instructions -->
                        <TextBlock Text="{Binding CurrentBeat.Prose}"
                                   FontSize="14" Foreground="#CDD6F4"
                                   TextWrapping="Wrap" LineHeight="22"
                                   Margin="0,0,0,20"/>

                        <!-- Item prompt -->
                        <TextBlock Text="{Binding CurrentItem.Prompt}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#CDD6F4"
                                   TextWrapping="Wrap" LineHeight="24"
                                   Visibility="{Binding CurrentItem, Converter={StaticResource NullToCollapsed}}"
                                   Margin="0,0,0,16"/>

                        <!-- Answer area (hidden while dialogue is showing) -->
                        <StackPanel Visibility="{Binding ShowDialogue, Converter={StaticResource BoolToCollapsedConverter}}">

                            <TextBox Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15"
                                     Margin="0,0,0,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SubmitAnswerCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Feedback -->
                            <TextBlock Text="{Binding FeedbackMessage}"
                                       FontSize="13" TextWrapping="Wrap"
                                       Margin="0,4,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A6E3A1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnswerCorrect}" Value="False">
                                                <Setter Property="Foreground" Value="#F38BA8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Hint reveal -->
                            <Button Content="Show hint"
                                    Command="{Binding RevealHintCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding CurrentItem, Converter={StaticResource NullToCollapsed}}"
                                    Margin="0,0,0,8"/>

                            <Border Background="#313244" CornerRadius="6" Padding="10,8"
                                    Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibleConverter}}"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding HintsRevealedCount, StringFormat='Hint {0}'}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#89B4FA" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentHint}"
                                               FontSize="13" Foreground="#CDD6F4"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════
                             DIALOGUE PANEL
                        ══════════════════════════════════════════ -->
                        <Border x:Name="DialoguePanel"
                                Visibility="{Binding ShowDialogue, Converter={StaticResource BoolToVisibleConverter}}"
                                Background="#1E1E2E"
                                BorderBrush="#45475A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0,0,0,0">

                            <StackPanel>

                                <!-- Script progress bar -->
                                <ProgressBar x:Name="DialogueProgress"
                                             Height="3"
                                             Background="#313244"
                                             Foreground="#89B4FA"
                                             BorderThickness="0"
                                             Value="{Binding DialogueLineIndex}"
                                             Maximum="{Binding ActiveDialogue.Lines.Count}"
                                             Margin="0,0,0,0"/>

                                <StackPanel Margin="14,12">

                                    <!-- Current speaker badge -->
                                    <Border HorizontalAlignment="Left"
                                            CornerRadius="4" Padding="8,3"
                                            Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#313244"/>
                                                <Style.Triggers>
                                                    <!-- Coach = blue, Peer = teal -->
                                                    <DataTrigger Binding="{Binding CurrentDialogueLine.Speaker}"
                                                                 Value="Coach">
                                                        <Setter Property="Background" Value="#1e3a5f"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentDialogueLine.Speaker}"
                                                                 Value="Peer">
                                                        <Setter Property="Background" Value="#1a3d35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CurrentDialogueLine.Speaker}"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentDialogueLine.Speaker}"
                                                                     Value="Coach">
                                                            <Setter Property="Foreground" Value="#89B4FA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CurrentDialogueLine.Speaker}"
                                                                     Value="Peer">
                                                            <Setter Property="Foreground" Value="#94E2D5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Dialogue text -->
                                    <TextBlock Text="{Binding CurrentDialogueLine.Text}"
                                               FontSize="14" Foreground="#CDD6F4"
                                               TextWrapping="Wrap" LineHeight="22"
                                               Margin="0,0,0,16"/>

                                    <!-- Playing indicator -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding IsAudioPlaying, Converter={StaticResource BoolToVisibleConverter}}">
                                        <Ellipse Width="6" Height="6" Fill="#89B4FA" Margin="0,0,4,0"/>
                                        <Ellipse Width="6" Height="6" Fill="#89B4FA" Margin="0,0,4,0" Opacity="0.6"/>
                                        <Ellipse Width="6" Height="6" Fill="#89B4FA" Opacity="0.3"/>
                                        <TextBlock Text=" Playing…" FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Next / Skip buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="Next →"
                                                Command="{Binding NextDialogueLineCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                                Content="Skip"
                                                Command="{Binding SkipDialogueCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom action row -->
                <Border Grid.Row="2"
                        BorderBrush="#45475A" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Submit"
                                Command="{Binding SubmitAnswerCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding ShowDialogue, Converter={StaticResource BoolToCollapsedConverter}}"/>

                        <Button Grid.Column="1"
                                Content="Next Beat →"
                                Command="{Binding NextBeatCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding ShowDialogue, Converter={StaticResource BoolToCollapsedConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL — geometry canvas
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="#11131F">
            <Border Margin="14"
                    Background="#FFFFFF"
                    BorderBrush="#89B4FA"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    ClipToBounds="True">
                <scene:SceneControl x:Name="Canvas"
                                    Scene="{Binding CurrentScene}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
            </Border>

            <!-- Lesson complete overlay -->
            <Border Visibility="{Binding IsLessonComplete, Converter={StaticResource BoolToVisibleConverter}}"
                    Background="#CC1E1E2E"
                    CornerRadius="8"
                    Margin="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✓ Lesson Complete"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#A6E3A1"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Head to the test when you're ready."
                               FontSize="14" Foreground="#9399B2"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
