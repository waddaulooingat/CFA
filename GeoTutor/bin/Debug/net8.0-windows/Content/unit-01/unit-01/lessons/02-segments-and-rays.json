      "maxAttempts": null
    },
    {
      "id": "worked",
      "type": "WorkedExample",
      "title": "Segment Addition",
      "scene": "scene_sr_worked",
      "steps": [
        {
          "order": 1,
          "text": "B lies between A and C, so the Segment Addition Postulate applies.",
          "canvasAction": { "type": "highlight", "target": "B" }
        },
        {
          "order": 2,
          "text": "Write the equation: AB + BC = AC.",
          "canvasAction": { "type": "annotate", "target": "segmentAC", "text": "AB + BC = AC" }
        },
        {
          "order": 3,
          "text": "Substitute: 7 + 12 = AC.",
          "canvasAction": null
        },
        {
          "order": 4,
          "text": "Add: AC = 19. Sanity-check: AC must be larger than either piece, and 19 > 12 ✓",
          "canvasAction": { "type": "annotate", "target": "segmentAC", "text": "AC = 19" }
        }
      ]
    },
    {
      "id": "check",
      "type": "Check",
      "items": [
        {
          "id": "sr-check-1",
          "kind": "multipleChoice",
          "prompt": "Which notation refers to a SEGMENT with endpoints A and B?",
          "choices": ["AB with double arrows", "AB with a single right arrow", "AB with a bar above", "AB with no marks"],
          "answerIndex": 2,
          "explanation": "A bar above the two letters denotes the segment. Double arrows = line, single arrow = ray, no marks = length (a number)."
        },
        {
          "id": "sr-check-2",
          "kind": "multipleChoice",
          "prompt": "Ray AB and ray BA are…",
          "choices": ["the same ray", "different rays, opposite directions", "the same as segment AB", "the same as line AB"],
          "answerIndex": 1,
          "explanation": "The endpoint comes first in the notation. Ray AB starts at A; ray BA starts at B. They head in opposite directions."
        }
      ]
    },
    {
      "id": "practice",
      "type": "Practice",
      "items": [
        {
          "id": "sr-prac-1",
          "kind": "numeric",
          "prompt": "B is between A and C. If AB = 5 and BC = 8, find AC.",
          "answer": 13,
          "tolerance": 0.01,
          "hints": [
            "B is between A and C — which postulate applies?",
            "Segment Addition: AB + BC = AC.",
            "Plug in: 5 + 8 = 13."
          ]
        },
        {
          "id": "sr-prac-2",
          "kind": "numeric",
          "prompt": "M is the midpoint of segment XY. If XM = 9, what is XY?",
          "answer": 18,
          "tolerance": 0.01,
          "hints": [
            "Midpoint means XM = MY.",
            "If XM = 9 and MY = 9, what is the whole?",
            "XY = XM + MY = 9 + 9 = 18."
          ]
        },
        {
          "id": "sr-prac-3",
          "kind": "numeric",
          "prompt": "B is between A and C. AC = 24 and AB = 9. Find BC.",
          "answer": 15,
          "tolerance": 0.01,
          "hints": [
            "Segment Addition: AB + BC = AC.",
            "Solve for BC: BC = AC − AB.",
            "BC = 24 − 9 = 15."
          ]
        },
        {
          "id": "sr-prac-4",
          "kind": "multipleChoice",
          "prompt": "Which statement uses the correct notation for two congruent segments?",
          "choices": [
            "Segment AB equals segment CD (with bars)",
            "AB ≅ CD (no bars, just letters)",
            "AB = CD (no bars, equals sign)",
            "Segment AB ≅ Segment CD (with bars over both)"
          ],
          "answerIndex": 3,
          "hints": [
            "Congruence symbol (≅) is for shapes; equals (=) is for numbers.",
            "Segments are shapes; lengths are numbers.",
            "Bars over both letters with ≅ between them is the correct form."
          ]
        }
      ]
    },
    {
