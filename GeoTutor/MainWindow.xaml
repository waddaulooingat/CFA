<Window x:Class="GeoTutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GeoTutor.Core.ViewModels"
        xmlns:views="clr-namespace:GeoTutor.Views"
        xmlns:scene="clr-namespace:GeoTutor.SceneEngine"
        Title="GeoTutor — Phase 1"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:Phase1ViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="#181825"
                BorderBrush="#45475A"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="16">

                <TextBlock Text="GeoTutor"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#89B4FA"
                           Margin="0,8,0,4"/>

                <TextBlock Text="Phase 1 — Scene Viewer"
                           FontSize="11"
                           Foreground="#6C7086"
                           Margin="0,0,0,24"/>

                <TextBlock Text="SAMPLE SCENES"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="#6C7086"
                           LetterSpacing="1"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding SceneTitle}"
                           FontSize="14"
                           Foreground="#CDD6F4"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding SceneCounter}"
                           FontSize="12"
                           Foreground="#6C7086"
                           Margin="0,0,0,20"/>

                <!-- Navigation buttons -->
                <Button Content="← Previous"
                        Command="{Binding PreviousCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,0,8"/>

                <Button Content="Next →"
                        Command="{Binding NextCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <!-- Phase badge -->
                <Border Background="#313244"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,32,0,0">
                    <StackPanel>
                        <TextBlock Text="Phase 1 complete:"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A6E3A1"
                                   Margin="0,0,0,4"/>
                        <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                            <Run>✓</Run><Run Foreground="#CDD6F4"> WPF shell + MVVM</Run>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                            <Run>✓</Run><Run Foreground="#CDD6F4"> SQLite schema</Run>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                            <Run>✓</Run><Run Foreground="#CDD6F4"> SkiaSharp renderer</Run>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                            <Run>✓</Run><Run Foreground="#CDD6F4"> 15 templates</Run>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                            <Run>✓</Run><Run Foreground="#CDD6F4"> 5 sample scenes</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ── Canvas area ─────────────────────────────────────── -->
        <Grid Grid.Column="1" Background="#1E1E2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="#181825"
                    BorderBrush="#45475A"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <TextBlock Text="{Binding SceneTitle}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#CDD6F4"/>
            </Border>

            <!-- Scene canvas -->
            <Border Grid.Row="1"
                    Margin="24"
                    Background="#313244"
                    BorderBrush="#45475A"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <scene:SceneControl Scene="{Binding CurrentScene}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>
</Window>
