<Window x:Class="GeoTutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GeoTutor.Core.ViewModels"
        xmlns:views="clr-namespace:GeoTutor.Views"
        xmlns:scene="clr-namespace:GeoTutor.SceneEngine"
        Title="GeoTutor — Phase 1"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:Phase1ViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="#181825"
                BorderBrush="#45475A"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0">

                <!-- App title area -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,0">
                    <TextBlock Text="GeoTutor"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#89B4FA"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Phase 1"
                               FontSize="11"
                               Foreground="#6C7086"
                               Margin="0,0,0,16"/>

                    <!-- ── Navigation ───────────────────────────── -->
                    <TextBlock Text="NAVIGATE"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#6C7086"
                               LetterSpacing="1"
                               Margin="0,0,0,6"/>

                    <Button x:Name="NavSceneBtn"
                            Content="Scene Viewer"
                            Click="Nav_SceneViewer_Click"
                            Style="{StaticResource NavButtonActive}"
                            Margin="0,0,0,2"/>

                    <Button x:Name="NavBaselineBtn"
                            Content="Prerequisites Baseline"
                            Click="Nav_Baseline_Click"
                            Style="{StaticResource NavButton}"
                            Margin="0,0,0,2"/>

                    <Button x:Name="NavUnit1Btn"
                            Content="Unit 1 — Foundations"
                            Click="Nav_Unit1_Click"
                            Style="{StaticResource NavButton}"
                            Margin="0,0,0,12"/>

                    <Separator Style="{StaticResource DarkSeparator}"/>
                </StackPanel>

                <!-- ── Scene Viewer Controls (dynamic section) ── -->
                <StackPanel x:Name="SceneControls"
                            DockPanel.Dock="Top"
                            Margin="16,0,16,0">

                    <TextBlock Text="SAMPLE SCENES"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#6C7086"
                               LetterSpacing="1"
                               Margin="0,4,0,8"/>

                    <TextBlock Text="{Binding SceneTitle}"
                               FontSize="14"
                               Foreground="#CDD6F4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding SceneCounter}"
                               FontSize="12"
                               Foreground="#6C7086"
                               Margin="0,0,0,20"/>

                    <Button Content="← Previous"
                            Command="{Binding PreviousCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,8"/>

                    <Button Content="Next →"
                            Command="{Binding NextCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <!-- Phase badge -->
                    <Border Background="#313244"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Phase 1 complete:"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A6E3A1"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                <Run>✓</Run><Run Foreground="#CDD6F4"> WPF shell + MVVM</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                <Run>✓</Run><Run Foreground="#CDD6F4"> SQLite schema</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                <Run>✓</Run><Run Foreground="#CDD6F4"> SkiaSharp renderer</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                <Run>✓</Run><Run Foreground="#CDD6F4"> 15 templates</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                <Run>✓</Run><Run Foreground="#CDD6F4"> 5 sample scenes</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Baseline Controls (shown in baseline mode) ── -->
                <StackPanel x:Name="BaselineSideControls"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Margin="16,0,16,0">

                    <TextBlock Text="PREREQUISITES BASELINE"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#6C7086"
                               LetterSpacing="1"
                               Margin="0,4,0,12"/>

                    <TextBlock Text="14 skill areas · ~39 items"
                               FontSize="14" Foreground="#CDD6F4"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="~10–15 minutes"
                               FontSize="12" Foreground="#6C7086"
                               Margin="0,0,0,12"/>

                    <Border Background="#313244"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="§3.1 Algebra (8 skills)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#89B4FA"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                Linear/quadratic equations, systems, factoring, exponents, functions, slope, distance
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="#313244"
                            CornerRadius="6"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="§3.2 Geometry (6 skills)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#94E2D5"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="#9399B2" TextWrapping="Wrap">
                                Angle vocab, transversals, triangle basics, coordinate plane, logic, area/perimeter
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Unit 1 Controls (shown in lesson mode) ── -->
                <StackPanel x:Name="Unit1SideControls"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Margin="16,0,16,0">

                    <TextBlock Text="UNIT 1 — FOUNDATIONS"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#6C7086"
                               LetterSpacing="1"
                               Margin="0,4,0,12"/>

                    <TextBlock Text="Select a skill to practise:"
                               FontSize="12" Foreground="#A6ADC8"
                               Margin="0,0,0,8"/>

                    <Button Content="Definitions &amp; Basics"
                            Tag="geo-u1-definitions"
                            Click="StartLesson_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Margin="0,0,0,6"/>

                    <Button Content="Angle Types"
                            Tag="geo-u1-angles"
                            Click="StartLesson_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Margin="0,0,0,6"/>

                    <Button Content="If-Then Logic"
                            Tag="geo-u1-logic-ifthen"
                            Click="StartLesson_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Margin="0,0,0,6"/>

                    <Button Content="Converse &amp; Contrapositive"
                            Tag="geo-u1-converse"
                            Click="StartLesson_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Margin="0,0,0,6"/>

                    <Button Content="Counterexamples"
                            Tag="geo-u1-counterexample"
                            Click="StartLesson_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"/>
            </DockPanel>
        </Border>

        <!-- ── Main content area ──────────────────────────────── -->
        <Grid Grid.Column="1" Background="#1E1E2E">

            <!-- Scene Viewer panel -->
            <Grid x:Name="Phase1Panel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0"
                        Background="#181825"
                        BorderBrush="#45475A"
                        BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <TextBlock Text="{Binding SceneTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#CDD6F4"/>
                </Border>

                <!-- Scene canvas -->
                <Border Grid.Row="1"
                        Margin="24"
                        Background="#313244"
                        BorderBrush="#45475A"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <scene:SceneControl Scene="{Binding CurrentScene}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                </Border>
            </Grid>

            <!-- Baseline panel (DataContext set in code-behind) -->
            <views:BaselineView x:Name="BaselinePanel"
                                Visibility="Collapsed"/>

            <!-- Lesson panel (DataContext set in code-behind when a skill is selected) -->
            <views:LessonView x:Name="LessonPanel"
                              Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
